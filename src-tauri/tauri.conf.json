{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "yarn build",
    "beforeDevCommand": "yarn start",
    "devPath": "http://localhost:3000",
    "distDir": "../build"
  },
  "package": {
    "productName": "hailstorm-app",
    "version": "0.2.2"
  },
  "tauri": {
    "allowlist": {
      "dialog": {
        "open": true,
        "save": true,
        "ask": true
      },
      "fs": {
        "scope": [
          "$CONFIG/hailstorm-app",
          "$CONFIG/hailstorm-app/*"
        ],
        "createDir": true,
        "readFile": true,
        "writeFile": true
      }
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "",
      "deb": {
        "depends": [],
        "files": {
          "/usr/share/applications/hailstorm-app.desktop": "../dist/linux/xdg/desktop/hailstorm-app.desktop",
          "/usr/share/mime/packages/hailstorm-app.xml": "../dist/linux/xdg/mime/hailstorm-app.xml",
          "/usr/share/icons/hicolor/32x32/apps/hailstorm-hsp.png": "icons/hsp/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/hailstorm-hsp.png": "icons/hsp/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/hailstorm-hsp.png": "icons/hsp/128x128@2x.png"
        }
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "dev.d71.hailstorm",
      "longDescription": "",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Hailstorm",
        "width": 800
      }
    ],
    "cli": {
      "description": "Hailstorm app lets you define your simulations",
      "args": [
        {
          "name": "project",
          "short": "p",
          "takesValue": true,
          "multiple": false
        }
      ]
    }
  }
}
