# Maintainer: Davide Ghilardi (davide.ghilardi@comelit.it)
pkgname=hailstorm-app-git
_pkgname=hailstorm-app
pkgver=0
pkgrel=1
pkgdesc="Manage and launch hailstorm projects"
url="https://github.com/dghilardi/hailstorm"
_git="https://gitlab.com/dghilardi/${_pkgname}.git"
arch=(x86_64)
makedepends=('cargo' 'yarn' 'webkit2gtk' 'curl' 'wget' 'openssl' 'gtk3' 'librsvg' 'libvips')
depends=()
provides=('hailstorm-app')
conflicts=('hailstorm-app-bin')
source=("${_pkgname}::git+${_git}")
sha256sums=('SKIP')
install=.INSTALL

_bin="hailstorm-app"
_lib_path="/usr/lib/${_pkgname}"
_rt_path="${_lib_path}/runtime"


pkgver() {
    cd "${_pkgname}"
    printf "%s.r%s.%s" "$(git describe --tags --abbrev=0)" "$(git rev-list --count $(git describe --tags --abbrev=0)..HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
	cd "${_pkgname}"
    yarn --frozen-lockfile
}

build() {
	cd "${_pkgname}"
	yarn tauri build -b none
}

check() {
	cd "${_pkgname}"
	# cargo test --all-features
}

package() {
	cd "${_pkgname}"
	mkdir -p "${pkgdir}${_lib_path}"
	# install -Dm 0644 "LICENSE" "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"
    install -Dm 0644 "dist/linux/xdg/desktop/hailstorm-app.desktop" "${pkgdir}/usr/share/applications/hailstorm-app.desktop"
    install -Dm 0644 "dist/linux/xdg/mime/hailstorm-app.xml" "${pkgdir}/usr/share/mime/packages/hailstorm-app.xml"
    install -Dm 0644 "src-tauri/icons/32x32.png" "${pkgdir}/usr/share/icons/hicolor/32x32/apps/hailstorm-app.png"
    install -Dm 0644 "src-tauri/icons/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/hailstorm-app.png"
    install -Dm 0644 "src-tauri/icons/128x128@2x.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/hailstorm-app.png"
    install -Dm 0644 "src-tauri/icons/hsp/32x32.png" "${pkgdir}/usr/share/icons/hicolor/32x32/apps/hailstorm-hsp.png"
    install -Dm 0644 "src-tauri/icons/hsp/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/hailstorm-hsp.png"
    install -Dm 0644 "src-tauri/icons/hsp/128x128@2x.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/hailstorm-hsp.png"
	install -Dm 0777 "src-tauri/target/release/${_bin}" "${pkgdir}/usr/bin/${_bin}"
}